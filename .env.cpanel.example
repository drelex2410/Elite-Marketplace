APP_NAME="Elite Group Marketplace"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpanel_database_name
DB_USERNAME=cpanel_database_user
DB_PASSWORD="replace-with-a-strong-password"

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MAIL_MAILER=smtp
MAIL_HOST=mail.your-domain.example
MAIL_PORT=465
MAIL_USERNAME=no-reply@your-domain.example
MAIL_PASSWORD="replace-with-mail-password"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=no-reply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=your-domain.example,www.your-domain.example
SESSION_DOMAIN=.your-domain.example

# Add live payment, OAuth, SMS, storage, and webhook credentials in cPanel.
# Never upload the local development .env file.
